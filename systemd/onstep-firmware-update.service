[Unit]
Description=Refresh cached OnStepX firmware from GitHub Releases when online
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/onstep-autoprovision/config.env
ExecStart=/opt/onstep-autoprovision/scripts/update_firmware.sh --all --allow-offline
StandardOutput=journal
StandardError=journal
SyslogIdentifier=onstep-firmware-update

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/onstep-autoprovision/firmware
