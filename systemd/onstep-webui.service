[Unit]
Description=OnStepX Auto-Provisioner Web UI & Astroberry Overlay API
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/onstep-autoprovision/config.env
Environment=WEBUI_HOST=0.0.0.0
Environment=WEBUI_PORT=8090
ExecStart=/opt/onstep-autoprovision/.venv/bin/python /opt/onstep-autoprovision/webui/onstep_webui.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=onstep-webui
SupplementaryGroups=dialout

# Security hardening (M1 + R7): strict filesystem confinement scoped to config/state/INDI/NM only
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
ProtectSystem=strict
ReadWritePaths=/etc/onstep-autoprovision /var/lib/onstep-autoprovision /opt/onstep-autoprovision/firmware /run/lock -/home/astroberry/.indi -/home/pi/.indi -/etc/NetworkManager/system-connections
CapabilityBoundingSet=CAP_SYS_TIME CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
AmbientCapabilities=
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
