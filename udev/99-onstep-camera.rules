# /etc/udev/rules.d/99-onstep-camera.rules
#
# Creates a stable /dev/astrocam symlink for the first USB UVC video capture node
# (ATTR{index}=="0" selects the actual frame-capture interface, ignoring metadata
# nodes such as /dev/video1 that modern Linux UVC kernels expose).
#
# If you plug in multiple USB cameras and want to pin a specific one, add
# ATTRS{idVendor}=="046d", ATTRS{idProduct}=="..." (from `lsusb`).

ACTION=="add", SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", \
  SUBSYSTEMS=="usb", ATTR{index}=="0", \
  MODE="0660", GROUP="video", \
  SYMLINK+="astrocam"
