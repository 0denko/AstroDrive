# /etc/udev/rules.d/99-onstep-nodemcu.rules
#
# Automated detection & readiness gating for ESP32 / NodeMCU OnStepX controllers.
#
# Architecture note:
#   - Creates per-device /dev/onstep-raw-%k immediately, NEVER /dev/onstep directly
#     (avoids symlink collisions when multiple USB-serial devices are attached).
#   - Blocks ModemManager from probing the port with AT commands (ID_MM_DEVICE_IGNORE=1).
#   - Triggers `onstep-autoprovision@%k.service` asynchronously via systemd (never runs
#     esptool inside udev RUN+=, avoiding udev's ~30-60s timeout).
#   - The systemd service verifies LX200 `:GVP# -> On-Step#` (and only flashes if explicitly
#     authorized via the Setup Wizard or AUTO_FLASH=true), then atomically publishes /dev/onstep.

# Silicon Labs CP2102 / CP2104 (ESP32-WROOM DevKit, Amica NodeMCU v2)
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
  MODE="0660", GROUP="dialout", \
  ENV{ID_MM_DEVICE_IGNORE}="1", \
  ENV{ONSTEP_RAW}="1", \
  SYMLINK+="onstep-raw-%k", \
  TAG+="systemd", \
  ENV{SYSTEMD_WANTS}="onstep-autoprovision@%k.service"

# QinHeng CH340 / CH340G (NodeMCU v3 LoLin, ESP32 clones)
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
  MODE="0660", GROUP="dialout", \
  ENV{ID_MM_DEVICE_IGNORE}="1", \
  ENV{ONSTEP_RAW}="1", \
  SYMLINK+="onstep-raw-%k", \
  TAG+="systemd", \
  ENV{SYSTEMD_WANTS}="onstep-autoprovision@%k.service"

# QinHeng CH9102 / CH9102F (modern ESP32-WROOM / ESP32-S2/S3 devkits)
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", \
  MODE="0660", GROUP="dialout", \
  ENV{ID_MM_DEVICE_IGNORE}="1", \
  ENV{ONSTEP_RAW}="1", \
  SYMLINK+="onstep-raw-%k", \
  TAG+="systemd", \
  ENV{SYSTEMD_WANTS}="onstep-autoprovision@%k.service"

# Espressif Native USB-CDC / JTAG (ESP32-S2 / S3 / C3 devkits — detected & surfaced in UI)
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
  MODE="0660", GROUP="dialout", \
  ENV{ID_MM_DEVICE_IGNORE}="1", \
  ENV{ONSTEP_RAW}="1", \
  SYMLINK+="onstep-raw-%k", \
  TAG+="systemd", \
  ENV{SYSTEMD_WANTS}="onstep-autoprovision@%k.service"

# Clean up /dev/onstep symlink when the matched USB device is unplugged
ACTION=="remove", SUBSYSTEM=="tty", ENV{ONSTEP_RAW}=="1", \
  RUN+="/bin/sh -c '[ \"$(readlink -f /dev/onstep 2>/dev/null)\" = \"/dev/%k\" ] && rm -f /dev/onstep || true'"
