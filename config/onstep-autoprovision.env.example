# /etc/onstep-autoprovision/config.env
# Copy to /etc/onstep-autoprovision/config.env (install.sh does this automatically)

# Target MCU family:
#   "auto"    -> Auto-detect ANY plugged-in NodeMCU via `esptool --chip auto chip_id`
#                and select the matching profile (esp8266 or esp32).
#   "esp8266" -> Strictly allow only ESP8266 boards.
#   "esp32"   -> Strictly allow only ESP32 boards.
TARGET_CHIP="auto"

# Maps detected esptool chip family -> profile folder under firmware/profiles/
CHIP_PROFILE_MAP="esp8266=nodemcu-esp8266-tmc2209s,esp32=nodemcu-esp32-tmc2209s"

# Safety gate: keep "false" until you have verified your USB filter/wiring.
# Set to "true" to automatically flash blank/new NodeMCU boards on plug-in.
AUTO_FLASH="false"

# If "true", re-flash an already-working OnStepX board whenever a newer version
# is available online or cached locally.
AUTO_UPGRADE="false"

# Online firmware resolution (automatically skipped when offline in the field):
# Pulls verified CI-built .bin releases from 0denko/AstroDrive before falling back
# to on-Pi live compilation.
GITHUB_REPO="0denko/AstroDrive"
ONLINE_CHECK_UPDATES="true"

# On-Pi Live Compilation fallback:
# When "true" and the Pi has internet access + arduino-cli installed, if no
# prebuilt .bin exists for the detected NodeMCU chip, the Pi pulls the latest
# hjd1964/OnStepX, applies firmware/profiles/<profile>/Config.h, compiles, caches,
# and flashes it automatically!
AUTO_COMPILE="true"

# Set "true" to ALWAYS pull latest upstream OnStepX and compile fresh on the Pi
# instead of using a prebuilt GitHub Release .bin.
PREFER_LIVE_COMPILE="false"

# Directory storing cached compiled binaries & manifests (<FIRMWARE_DIR>/<profile>/)
FIRMWARE_DIR="/opt/onstep-autoprovision/firmware"
BUILD_SCRIPT="/opt/onstep-autoprovision/firmware-src/build.sh"
UPDATE_SCRIPT="/opt/onstep-autoprovision/scripts/update_firmware.sh"

# Persistent symlink exposed to INDI (`indi_lx200_OnStep`) ONLY after verification
SYMLINK_PATH="/dev/onstep"

# Comma-separated baud rates probed in order during LX200 :GVP# detection.
# OnStepX SERIAL_A_BAUD_DEFAULT and indi_lx200_OnStep default to 9600.
PROBE_BAUDS="9600,115200,57600,19200"

# esptool flash baud rates (falls back to FLASH_BAUD_FALLBACK on sync errors)
FLASH_BAUD="460800"
FLASH_BAUD_FALLBACK="115200"

# Seconds to wait after USB plug-in before opening serial (avoids boot noise)
BOOT_SETTLE_SECONDS="2.5"

# Optional safety allowlist (STRONGLY RECOMMENDED if other CP2102/CH340 devices
# like autofocusers, GPS dongles, or dew controllers are plugged into the Pi).
# Find values via: udevadm info -q property -n /dev/ttyUSB0 | grep -E 'ID_SERIAL_SHORT|ID_PATH='
# Leave empty to accept any random NodeMCU plugged into any USB port.
ALLOWED_USB_SERIALS=""
ALLOWED_USB_PATHS=""

# Optional: trigger INDI driver reconnect via `indi_setprop` after provisioning
INDI_AUTO_CONNECT="false"
INDI_DEVICE_NAME="LX200 OnStep"
