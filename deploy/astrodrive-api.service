[Unit]
Description=AstroDrive FastAPI backend
# deliberately not ordered after astrodrive-update: that unit is oneshot, so the web UI would
# stay down for the whole of a firmware toolchain download and build
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astrodrive
Group=astrodrive
WorkingDirectory=/opt/astrodrive/backend/api
EnvironmentFile=/etc/astrodrive/astrodrive.env
ExecStart=/opt/astrodrive/backend/api/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
