ASTRODRIVE_REPO_URL=https://github.com/REPLACE_ME/AstroDrive.git
ASTRODRIVE_BRANCH=main
ASTRODRIVE_INSTALL_DIR=/opt/astrodrive
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=telescope/mount/command
ESP32_SERIAL_PORT=auto
ESP32_SERIAL_BAUD=115200
ESP32_AUTO_FLASH=true
# PlatformIO environment to build and flash: esp32dev for an ESP32, nodemcuv2 for an ESP8266
# NodeMCU, or auto to ask the attached chip which it is. Auto cannot tell two boards apart when
# they share a USB bridge with no serial number, so a swap between those still needs setting by hand
ESP32_BOARD_ENV=esp32dev
CAMERA_URL=/camera/?action=stream
CAMERA_DEVICE=auto
# unset uses the camera's own MJPEG; 1-100 captures YUYV and re-encodes at that quality instead
CAMERA_QUALITY=
CORS_ORIGINS=*
